{
  "manifest_version": 3,
  "name": "Title changer",
  "version": "0.0.3",
  "description": "An extension that changes the title!",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/pencil_logo.png",
      "32": "images/pencil_logo.png",
      "48": "images/pencil_logo.png",
      "128": "images/pencil_logo.png"
    }
  }
}
